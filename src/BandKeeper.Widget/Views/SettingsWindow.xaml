<Window x:Class="BandKeeper.Widget.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BandKeeper Settings"
        Width="420"
        Height="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Adapter" FontWeight="SemiBold" />
        <ComboBox Grid.Row="1" Margin="0,6,0,12" x:Name="AdapterComboBox" DisplayMemberPath="Name"/>

        <CheckBox Grid.Row="2" x:Name="IncludeVpnCheckBox" Content="Include VPN/Tunnel adapters" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <TextBlock Text="Polling interval (ms)" FontWeight="SemiBold" />
            <TextBox x:Name="PollingIntervalTextBox" Margin="0,6,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,0,0,12">
            <TextBlock Text="Widget opacity (%)" FontWeight="SemiBold" />
            <TextBox x:Name="OpacityTextBox" Margin="0,6,0,0" />
        </StackPanel>

        <CheckBox Grid.Row="5" x:Name="StartWithWindowsCheckBox" Content="Start with Windows" VerticalAlignment="Top"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" Click="OnCancelClicked" />
            <Button Content="Save" Width="90" Click="OnSaveClicked" />
        </StackPanel>
    </Grid>
</Window>
